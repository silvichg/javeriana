<!doctype html>
<html lang="es" class="">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Competencia en Guatemala – Caso informativo</title>
  <meta name="description" content="Landing informativa sobre competencia y protección del consumidor en Guatemala. Plantilla base para publicar un caso o guía local." />

  <!-- Tailwind CSS (CDN) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Tailwind config con modo oscuro por clase
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            canvasDark: "#05070B",
          },
          backgroundImage: {
            "gradient-radial": "radial-gradient(var(--tw-gradient-stops))",
          },
          boxShadow: {
            glass: "0 8px 40px -16px rgba(0,0,0,.6)",
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
  </style>

  <!-- Script: aplica dark por preferencia del sistema / localStorage ANTES de pintar -->
  <script>
    (() => {
      const ls = localStorage.getItem("theme");
      const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      const shouldDark = ls ? ls === "dark" : prefersDark;
      document.documentElement.classList.toggle("dark", shouldDark);
    })();
  </script>
</head>

<body class="bg-white text-slate-900 dark:bg-canvasDark dark:text-white selection:bg-blue-600 selection:text-white">

  <!-- Fondos con gradientes -->
  <div class="pointer-events-none fixed inset-0 -z-10">
    <div class="absolute -top-32 left-1/2 h-80 w-[50rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-blue-700/20 via-cyan-400/15 to-white/20 blur-3xl dark:from-blue-700/40 dark:via-cyan-400/20 dark:to-white/5"></div>
    <div class="absolute bottom-0 right-[-10%] h-80 w-[40rem] rounded-full bg-gradient-to-tl from-cyan-500/20 via-blue-400/15 to-transparent blur-3xl dark:from-cyan-500/30 dark:via-blue-400/20"></div>
  </div>

  <!-- Header / Nav -->
  <header class="sticky top-0 z-40 border-b bg-white/70 backdrop-blur supports-[backdrop-filter]:bg-white/60 border-slate-200 dark:border-white/10 dark:bg-black/40">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-400 text-black">
          <i data-lucide="scale" class="opacity-90" aria-hidden="true"></i>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-slate-600 dark:text-white/70">Investigación · Competencia</p>
          <p class="text-sm font-semibold">Guatemala</p>
        </div>
      </div>

      <nav class="hidden items-center gap-3 md:flex">
        <button data-scroll="#resumen" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Resumen</button>
        <button data-scroll="#mecanismo" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Marco</button>
        <button data-scroll="#hechos" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Hechos</button>
        <button data-scroll="#pretensiones" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Acciones</button>
        <button data-scroll="#decision" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Conclusión</button>
        <button data-scroll="#lecciones" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Lecciones</button>
        <button data-scroll="#faq" class="rounded-full px-3 py-1 text-sm text-slate-700 hover:bg-slate-100 dark:text-white/90 dark:hover:bg-white/10">Recursos</button>

        <!-- Toggle -->
        <button id="themeToggle" class="ml-2 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm transition
                       border-slate-300 hover:bg-slate-100 text-slate-700
                       dark:border-white/15 dark:bg-white/5 dark:text-white/90 dark:hover:bg-white/10"
                type="button" aria-pressed="false" title="Cambiar tema">
          <i data-lucide="sun" class="h-4 w-4 hidden dark:block"></i>
          <i data-lucide="moon" class="h-4 w-4 block dark:hidden"></i>
          <span class="hidden sm:inline">Tema</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative overflow-hidden py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs text-slate-700 border-slate-200 bg-white/70
                      dark:border-white/10 dark:bg-white/5 dark:text-white/80">
            <i data-lucide="book-open" class="h-3.5 w-3.5" aria-hidden="true"></i>
            Investigación sobre competencia y protección al consumidor
          </div>
          <h1 class="text-4xl/tight md:text-6xl/tight font-semibold">
            Competencia en Guatemala:
            <span class="block bg-gradient-to-r from-slate-900 via-blue-700 to-cyan-600 bg-clip-text text-transparent dark:from-white dark:via-blue-200 dark:to-cyan-200">
              casos, normas y recomendaciones para consumidores
            </span>
          </h1>
          <p class="mt-5 max-w-prose text-lg text-slate-700 dark:text-gray-200/95">
            Documento informativo que agrupa hallazgos, fechas clave y buenas prácticas para la protección del consumidor en temas de competencia en Guatemala.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
            <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 ring-1 ring-slate-200 text-slate-800
                          dark:bg-white/10 dark:ring-white/10 dark:text-white/90">
              <i data-lucide="search" class="h-4 w-4" aria-hidden="true"></i> Análisis local
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 ring-1 ring-slate-200 text-slate-800
                          dark:bg-white/10 dark:ring-white/10 dark:text-white/90">
              <i data-lucide="gavel" class="h-4 w-4" aria-hidden="true"></i> Marcos normativos
            </span>
            <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 ring-1 ring-slate-200 text-slate-800
                          dark:bg-white/10 dark:ring-white/10 dark:text-white/90">
              <i data-lucide="users" class="h-4 w-4" aria-hidden="true"></i> Recomendaciones prácticas
            </span>
          </div>
          <div class="mt-8 flex gap-3">
            <a href="#decision" class="rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-400 px-5 py-3 font-medium text-black transition hover:brightness-110">
              Ver conclusiones
            </a>
            <a href="#hechos" class="rounded-2xl border border-slate-300 bg-white/70 px-5 py-3 font-medium text-slate-900 hover:bg-slate-100
                                     dark:border-white/15 dark:bg-white/5 dark:text-white/90 dark:hover:bg-white/10">
              Hechos y cronología
            </a>
          </div>
        </div>

        <!-- Stats card -->
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur
                    dark:border-white/10 dark:bg-white/5">
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 dark:bg-black/30 dark:ring-white/10">
              <p class="text-xs text-slate-600 dark:text-white/70">Área de estudio</p>
              <p class="mt-1 text-2xl font-semibold">Competencia</p>
            </div>
            <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 dark:bg-black/30 dark:ring-white/10">
              <p class="text-xs text-slate-600 dark:text-white/70">Jurisdicción</p>
              <p class="mt-1 text-2xl font-semibold">Guatemala</p>
            </div>
            <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 dark:bg-black/30 dark:ring-white/10">
              <p class="text-xs text-slate-600 dark:text-white/70">Formato</p>
              <p class="mt-1 text-2xl font-semibold">Resumen público</p>
            </div>
            <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 dark:bg-black/30 dark:ring-white/10">
              <p class="text-xs text-slate-600 dark:text-white/70">Estado</p>
              <p class="mt-1 text-2xl font-semibold">Borrador</p>
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-white/10 dark:bg-white/5">
              <div class="flex items-start gap-3">
                <i data-lucide="info" class="mt-0.5 h-4 w-4" aria-hidden="true"></i>
                <div>
                  <p class="text-sm font-medium">Editable</p>
                  <p class="text-sm text-slate-700 dark:text-gray-300/90">Cambia cifras, fechas y referencias locales según necesites.</p>
                </div>
              </div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-white/10 dark:bg-white/5">
              <div class="flex items-start gap-3">
                <i data-lucide="calendar-days" class="mt-0.5 h-4 w-4" aria-hidden="true"></i>
                <div>
                  <p class="text-sm font-medium">Última actualización</p>
                  <p class="text-sm text-slate-700 dark:text-gray-300/90">Editar fecha al publicar.</p>
                </div>
              </div>
            </div>
          </div>
        </div><!-- /stats card -->
      </div>
    </div>
  </section>

  <!-- Resumen -->
  <section id="resumen" class="relative py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs tracking-wide text-slate-700 border-slate-200 bg-white/70
                  dark:border-white/10 dark:bg-white/5 dark:text-white/80">
        <span class="inline-block h-2 w-2 rounded-full bg-gradient-to-r from-blue-400 to-cyan-300"></span>
        Resumen ejecutivo
      </div>
      <h2 class="text-2xl md:text-4xl font-semibold drop-shadow-sm">Qué contiene esta guía</h2>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur dark:border-white/10 dark:bg-white/5">
          <div class="flex items-center gap-3">
            <i data-lucide="file-text" class="h-4 w-4" aria-hidden="true"></i>
            <p class="font-medium">Contexto</p>
          </div>
          <p class="mt-2 text-slate-700 dark:text-gray-300/90">
            Resumen del caso, normativa aplicable en Guatemala (referir organismos y leyes locales) y recomendaciones prácticas.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur dark:border-white/10 dark:bg-white/5">
          <div class="flex items-center gap-3">
            <i data-lucide="alert-circle" class="h-4 w-4" aria-hidden="true"></i>
            <p class="font-medium">Problemas detectados</p>
          </div>
          <p class="mt-2 text-slate-700 dark:text-gray-300/90">
            Prácticas que afectan la competencia o la transparencia frente al consumidor.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur dark:border-white/10 dark:bg-white/5">
          <div class="flex items-center gap-3">
            <i data-lucide="gavel" class="h-4 w-4" aria-hidden="true"></i>
            <p class="font-medium">Acciones sugeridas</p>
          </div>
          <p class="mt-2 text-slate-700 dark:text-gray-300/90">
            Recomendaciones para consumidores, reguladores y proveedores para mejorar transparencia y competencia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- (Secciones restantes mantienen estructura similar a la plantilla original: Mecanismo, Hechos, Pretensiones, Decisión, Lecciones, Recursos) -->

  <section id="mecanismo" class="relative py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs tracking-wide text-slate-700 border-slate-200 bg-white/70
                  dark:border-white/10 dark:bg-white/5 dark:text-white/80">
        <span class="inline-block h-2 w-2 rounded-full bg-gradient-to-r from-blue-400 to-cyan-300"></span>
        Marco legal y organismos
      </div>
      <h2 class="text-2xl md:text-4xl font-semibold drop-shadow-sm">Organismos y normas relevantes</h2>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur dark:border-white/10 dark:bg-white/5">
          <p class="text-sm text-slate-800 dark:text-white/90">
            (Aquí puedes listar autoridades guatemaltecas: ejemplo: Comisión de Competencia, organismos de protección al consumidor, leyes aplicables, etc.)
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-glass backdrop-blur dark:border-white/10 dark:bg-white/5">
          <p class="text-sm text-slate-800 dark:text-white/90">
            (Incluye enlaces, documentos o referencias locales cuando los tengas.)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white/70 dark:border-white/10 dark:bg-black/40">
    <div class="mx-auto max-w-7xl px-6 py-10 text-sm text-slate-700 dark:text-white/70">
      <p>Proyecto: Competencia en Guatemala · Documento informativo</p>
      <p class="mt-1">Todos los derechos reservados.</p>
    </div>
  </footer>

  <!-- Lucide icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    // Inicializar iconos
    if (window.lucide) lucide.createIcons();

    // Scroll suave en botones de la nav
    document.querySelectorAll("[data-scroll]").forEach(btn => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-scroll");
        if (target) document.querySelector(target)?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Toggle claro/oscuro
    const toggle = document.getElementById("themeToggle");
    const setTheme = (mode) => {
      const isDark = mode === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      localStorage.setItem("theme", mode);
      toggle?.setAttribute("aria-pressed", String(isDark));
      if (window.lucide) lucide.createIcons();
    };

    toggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      setTheme(isDark ? "light" : "dark");
    });
  </script>
</body>
</html>